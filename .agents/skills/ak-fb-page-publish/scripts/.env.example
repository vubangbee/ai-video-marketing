# ============================================================================
# ak:fb-page-publish — cấu hình đăng bài fanpage Facebook
# ============================================================================
# Copy file này thành `.env` rồi sửa giá trị. Không commit `.env`.
#
# TRƯỚC KHI DÙNG, cần làm 3 việc một lần (xem references/setup-permissions.md):
#
#   1. Cấp scope `pages_manage_posts` và `pages_read_user_content` cho System
#      User token ở business.facebook.com > Business Settings > System Users.
#      Không có scope này, mọi lệnh đăng trả lỗi (#200).
#
#   2. Bật "Google Drive API" trong project Google Cloud chứa service account
#      bên dưới. Không bật thì mọi lệnh tải file từ Drive trả 403.
#
#   3. Share folder media và file Google Docs cho email service account
#      (chạy `python drive_client.py whoami` để lấy email đó).
# ============================================================================


# --- Meta / Facebook Graph API ---------------------------------------------

# Token System User có scope pages_manage_posts + pages_read_user_content.
# Đây là nơi token đăng bài được lưu (quyết định 08/09/2026): tách riêng khỏi
# token quảng cáo của ak-ads-management để hai skill không kéo đổ nhau khi
# một bên phải cấp lại token.
# Bỏ trống => lùi về kế thừa token của ak-ads-management (token đó hiện THIẾU
# pages_manage_posts nên sẽ không đăng được bài).
# Xem references/setup-permissions.md để lấy token.
META_ACCESS_TOKEN=

# Phiên bản Graph API. Reels (/video_reels) cần v15.0 trở lên.
META_API_VERSION=v21.0


# --- Bảng fanpage -----------------------------------------------------------
# Đánh số liên tục từ 1. Script đọc tới khi hụt số thì dừng, nên muốn bỏ một
# page thì phải đánh số lại cho liền mạch.
#
#   FB_PAGE_CODE_N  mã ngắn để gõ ngoài dòng lệnh (--page Sua)
#   FB_PAGE_ID_N    Page ID lấy từ `python fb_page_publish.py check-auth`
#   FB_PAGE_NAME_N  tên hiển thị, chỉ dùng để in ra cho dễ đọc

FB_PAGE_CODE_1=Sua
FB_PAGE_ID_1=108067022357425
FB_PAGE_NAME_1=Bác sĩ Đắc Quang - Bác sĩ Sửa

FB_PAGE_CODE_2=BSDQ
FB_PAGE_ID_2=107684028988499
FB_PAGE_NAME_2=Bác sĩ Đắc Quang

FB_PAGE_CODE_3=PTTM
FB_PAGE_ID_3=180350405152355
FB_PAGE_NAME_3=Bác Sĩ Đắc Quang - Phẫu thuật Thẩm mỹ

FB_PAGE_CODE_4=ATCYK
FB_PAGE_ID_4=767583606434885
FB_PAGE_NAME_4=Dr. Đắc Quang - Thẩm Mỹ An Toàn Chuẩn Y Khoa

FB_PAGE_CODE_5=CSCH
FB_PAGE_ID_5=714943528375165
FB_PAGE_NAME_5=Dr. Đắc Quang - Chuyên Sửa Ca Hỏng

FB_PAGE_CODE_6=TH3V
FB_PAGE_ID_6=131922183331844
FB_PAGE_NAME_6=Tạo hình 3 vòng - Bs Quang

FB_PAGE_CODE_7=CGSM
FB_PAGE_ID_7=106685279170357
FB_PAGE_NAME_7=Bác sĩ Đắc Quang - Chuyên Gia Sửa Mũi

FB_PAGE_CODE_8=TMDQ
FB_PAGE_ID_8=61551218187306
FB_PAGE_NAME_8=Thẩm mỹ Đắc Quang (page test)


# --- Google Drive -----------------------------------------------------------

# Đường dẫn tới file JSON key của service account. Đường dẫn tương đối tính từ
# thư mục scripts/ này. Dùng chung key với skill ak-google-sheets.
#
# CẢNH BÁO: file này chứa private key. Nếu bạn đặt nó ngay trong scripts/
# (khuyến nghị, để skill tự chứa), thì KHÔNG BAO GIỜ commit nó và KHÔNG copy
# nó theo khi chia sẻ skill cho người khác. Chỉ copy `.env.example`.
GOOGLE_DRIVE_CREDENTIALS=service-account.json

# Nơi lưu media tải từ Drive. Bỏ trống => thư mục temp của hệ điều hành.
DRIVE_DOWNLOAD_DIR=


# --- Kiểm tra media (tuỳ chọn) ----------------------------------------------

# Đường dẫn tới ffprobe.exe, dùng để đo độ dài / độ phân giải / tỉ lệ khung
# hình video trước khi đăng. Bỏ trống => tự dò trong PATH và các thư mục cài
# đặt quen thuộc của winget. Không tìm thấy thì script chỉ kiểm tra được phần
# mở rộng và dung lượng file.
FFPROBE_PATH=


# --- Khác -------------------------------------------------------------------

# Múi giờ dùng để hiểu giờ hẹn đăng bạn nhập vào và để in giờ ra màn hình.
DEFAULT_TIMEZONE=Asia/Bangkok
